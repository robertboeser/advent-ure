{
  "name": "advent-ure",
  "version": "0.1.0",
  "private": true,
  "description": "Die vierundzwanzigste Tür – ein weihnachtliches Textadventure für den Browser",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "test": "node --test \"tests/*.test.mjs\"",
    "validate": "node tools/validate-graph.mjs",
    "simulate": "node tools/simulate.mjs",
    "graph": "node tools/export-mermaid.mjs",
    "check": "npm run validate && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
